{
  "manifest_version": 3,
  "name": "WCAG Access Page Scanner",
  "version": "0.1.0",
  "description": "Scan the current page for WCAG accessibility issues using axe-core.",
  "action": {
    "default_title": "WCAG Access",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
